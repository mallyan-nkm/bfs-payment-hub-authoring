{
  "uid": "th-ports",
  "title": "TransactHub: Ports",
  "description": "Calls on ports (simulators in a test deployment, the native host and the bank's connections), and the deployed workers that make them (R-09-33).",
  "tags": [
    "transacthub"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "port",
        "label": "Port",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "th-prometheus"
        },
        "query": {
          "query": "label_values(th_port_call_duration_seconds_count, th_port)",
          "refId": "v"
        },
        "definition": "label_values(th_port_call_duration_seconds_count, th_port)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Port calls per second, by port",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "th-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "th-prometheus"
          },
          "expr": "sum by (th_port) (rate(th_port_call_duration_seconds_count{th_port=~\"$port\"}[$__rate_interval]))",
          "legendFormat": "{{th_port}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Port call latency p95, by port",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "th-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "th-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, th_port) (rate(th_port_call_duration_seconds_bucket{th_port=~\"$port\"}[$__rate_interval])))",
          "legendFormat": "{{th_port}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Port call errors per minute (failed, not answered)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "th-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "th-prometheus"
          },
          "expr": "sum by (th_port, th_error) (rate(th_port_call_errors_total{th_port=~\"$port\"}[$__rate_interval])) * 60",
          "legendFormat": "{{th_port}} {{th_error}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Port call results",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "th-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "th-prometheus"
          },
          "expr": "sum by (th_port, th_port_result) (rate(th_port_call_duration_seconds_count{th_port=~\"$port\"}[$__rate_interval]))",
          "legendFormat": "{{th_port}} {{th_port_result}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Worker attempt latency p95, by queue",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "th-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "th-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, th_queue) (rate(th_worker_attempt_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{th_queue}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Worker attempt errors per minute",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "th-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "th-prometheus"
          },
          "expr": "sum by (th_queue, th_error) (rate(th_worker_attempt_errors_total[$__rate_interval])) * 60",
          "legendFormat": "{{th_queue}} {{th_error}}"
        }
      ]
    }
  ],
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "TransactHub",
      "type": "dashboards",
      "tags": [
        "transacthub"
      ],
      "asDropdown": true
    }
  ]
}
