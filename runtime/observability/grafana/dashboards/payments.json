{
  "uid": "th-payments",
  "title": "TransactHub: Payments",
  "description": "Payments (a file is one) by outcome, scheme, tenant and engine; how long they take; holds (R-09-34).",
  "tags": [
    "transacthub"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "engine",
        "label": "Engine",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "th-prometheus"
        },
        "query": {
          "query": "label_values(th_payments_total, th_engine)",
          "refId": "v"
        },
        "definition": "label_values(th_payments_total, th_engine)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      },
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "th-prometheus"
        },
        "query": {
          "query": "label_values(th_payments_total, th_tenant)",
          "refId": "v"
        },
        "definition": "label_values(th_payments_total, th_tenant)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      },
      {
        "name": "scheme",
        "label": "Scheme",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "th-prometheus"
        },
        "query": {
          "query": "label_values(th_payments_total, th_scheme)",
          "refId": "v"
        },
        "definition": "label_values(th_payments_total, th_scheme)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Payments ended per minute, by outcome",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "th-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "th-prometheus"
          },
          "expr": "sum by (th_outcome) (rate(th_payments_total{th_engine=~\"$engine\", th_tenant=~\"$tenant\", th_scheme=~\"$scheme\"}[$__rate_interval])) * 60",
          "legendFormat": "{{th_outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Payments ended per minute, by engine and scheme",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "th-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "th-prometheus"
          },
          "expr": "sum by (th_engine, th_scheme) (rate(th_payments_total{th_engine=~\"$engine\", th_tenant=~\"$tenant\", th_scheme=~\"$scheme\"}[$__rate_interval])) * 60",
          "legendFormat": "{{th_engine}} {{th_scheme}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Payment duration p50 / p95 / p99",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "th-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "th-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, th_engine) (rate(th_payment_duration_seconds_bucket{th_engine=~\"$engine\", th_tenant=~\"$tenant\", th_scheme=~\"$scheme\"}[$__rate_interval])))",
          "legendFormat": "p50 {{th_engine}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "th-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, th_engine) (rate(th_payment_duration_seconds_bucket{th_engine=~\"$engine\", th_tenant=~\"$tenant\", th_scheme=~\"$scheme\"}[$__rate_interval])))",
          "legendFormat": "p95 {{th_engine}}"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "th-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, th_engine) (rate(th_payment_duration_seconds_bucket{th_engine=~\"$engine\", th_tenant=~\"$tenant\", th_scheme=~\"$scheme\"}[$__rate_interval])))",
          "legendFormat": "p99 {{th_engine}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Lines (credits) ended per second",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "th-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "th-prometheus"
          },
          "expr": "sum by (th_engine, th_outcome) (rate(th_payment_lines_total{th_engine=~\"$engine\", th_tenant=~\"$tenant\", th_scheme=~\"$scheme\"}[$__rate_interval]))",
          "legendFormat": "{{th_engine}} {{th_outcome}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Not settled in the range",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "th-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "th-prometheus"
          },
          "expr": "sum(increase(th_payments_total{th_engine=~\"$engine\", th_tenant=~\"$tenant\", th_scheme=~\"$scheme\", th_outcome!=\"settled\"}[$__range]))",
          "legendFormat": "not settled"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Settled in the range",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "th-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 16,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "th-prometheus"
          },
          "expr": "sum(increase(th_payments_total{th_engine=~\"$engine\", th_tenant=~\"$tenant\", th_scheme=~\"$scheme\", th_outcome=\"settled\"}[$__range]))",
          "legendFormat": "settled"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Holds open (waiting for a decision)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "th-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "th-prometheus"
          },
          "expr": "sum by (th_activity) (th_holds_open)",
          "legendFormat": "{{th_activity}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Holds raised per minute",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "th-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "th-prometheus"
          },
          "expr": "sum by (th_activity) (rate(th_holds_total[$__rate_interval])) * 60",
          "legendFormat": "{{th_activity}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Release activations",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "th-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "th-prometheus"
          },
          "expr": "sum by (th_environment, th_scope) (increase(th_release_activations_total[$__range]))",
          "legendFormat": "{{th_environment}} {{th_scope}}"
        }
      ]
    }
  ],
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "TransactHub",
      "type": "dashboards",
      "tags": [
        "transacthub"
      ],
      "asDropdown": true
    }
  ]
}
