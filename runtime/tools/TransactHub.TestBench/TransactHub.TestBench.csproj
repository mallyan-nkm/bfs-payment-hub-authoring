<Project Sdk="Microsoft.NET.Sdk">

  <!-- The runtime test bench (runtime/testbench/README.md): send data, run it on the engines a profile names, each
       with the store on its database, and compare every engine with the studio interpreter. A CLI and a small
       HTTP service of its own, never the production API. It reuses the engine harnesses unchanged. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>testbench</AssemblyName>
    <RootNamespace>TransactHub.TestBench</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers.MsSql" Version="4.17.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TransactHub.Auth\TransactHub.Auth.csproj" />
    <ProjectReference Include="..\..\src\TransactHub.Security\TransactHub.Security.csproj" />
    <ProjectReference Include="..\..\src\TransactHub.Store\TransactHub.Store.csproj" />
    <ProjectReference Include="..\..\src\TransactHub.Store.Migrations.SqlServer\TransactHub.Store.Migrations.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\TransactHub.Store.Migrations.PostgreSql\TransactHub.Store.Migrations.PostgreSql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TransactHub.TestBench.Tests" />
  </ItemGroup>

</Project>
