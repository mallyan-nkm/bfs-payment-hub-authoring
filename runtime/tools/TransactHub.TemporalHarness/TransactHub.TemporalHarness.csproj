<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\TransactHub.Engine.Temporal\TransactHub.Engine.Temporal.csproj" />
    <ProjectReference Include="..\..\src\TransactHub.Telemetry\TransactHub.Telemetry.csproj" />
  </ItemGroup>

  <ItemGroup>
