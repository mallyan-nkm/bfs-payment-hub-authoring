<Project Sdk="Microsoft.NET.Sdk">

  <!-- The studio's Elsa harness (studio/engines/elsa/harness) built against the runtime: the same engine
       code, with the claim check journalled to the store when TH_STORE_PROVIDER is set (plan N4). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS8604;CS8602;CS8600;CS8619;CS8620;CS1998</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../../studio/engines/elsa/harness/*.cs" Link="harness/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TransactHub.Engines.Durable\TransactHub.Engines.Durable.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Elsa" Version="3.10.2" />
  </ItemGroup>

</Project>
