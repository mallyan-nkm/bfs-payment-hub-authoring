<Project Sdk="Microsoft.NET.Sdk">

  <!-- The long-running engine host (Issues I-114, I-127): a supervisor per engine, bank and environment that starts one host per
       distribution at installation and stops it at removal. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\TransactHub.Engine.Temporal\TransactHub.Engine.Temporal.csproj" />
    <ProjectReference Include="..\..\src\TransactHub.Engines.Durable\TransactHub.Engines.Durable.csproj" />
    <ProjectReference Include="..\..\src\TransactHub.Security\TransactHub.Security.csproj" />
    <!-- The plan of a host from the stored package's YAML (R-09-94). -->
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- One platform's native Temporal bridge in the output, not every one's. -->
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

</Project>
