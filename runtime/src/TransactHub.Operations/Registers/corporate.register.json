{
  "kind": "register-kind",
  "name": "corporate",
  "title": "Corporate registration",
  "description": "The bank's corporate customers: who may send a salary file and from which accounts. Bank customer data: kept in the runtime only, never sent to the studio or to GitHub. Modelled on the ISO 20022 party (Pty) with its organisation identification (OrgId/Othr, one per issuing scheme), postal address, contact details and accounts. The fields are those of the TransactHub source's CorporateRegistration.",
  "key": "corporateId",
  "titleField": "name",
  "fields": [
    { "id": "corporateId", "title": "Corporate id", "type": "text", "required": true, "lookup": true, "iso": "Pty/Id/OrgId/Othr/Id (SchmeNm/Prtry BANK)", "pattern": "^[A-Za-z0-9-]{1,35}$" },
    { "id": "name", "title": "Corporate name", "type": "text", "required": true, "iso": "Pty/Nm" },
    { "id": "address1", "title": "Address line 1", "type": "text", "iso": "Pty/PstlAdr/AdrLine[1]" },
    { "id": "address2", "title": "Address line 2", "type": "text", "iso": "Pty/PstlAdr/AdrLine[2]" },
    { "id": "emirate", "title": "Emirate", "type": "code", "references": "emirates", "iso": "Pty/PstlAdr/CtrySubDvsn" },
    { "id": "telephone", "title": "Telephone", "type": "text", "personal": true, "mask": "id", "iso": "Pty/CtctDtls/PhneNb" },
    { "id": "emails", "title": "E-mails", "type": "list", "personal": true, "mask": "name", "iso": "Pty/CtctDtls/EmailAdr" },
    { "id": "tradeLicenceNo", "title": "Trade licence", "type": "text", "mask": "id", "iso": "Pty/Id/OrgId/Othr/Id (SchmeNm/Prtry TRADE-LICENCE)" },
    { "id": "licenceExpiry", "title": "Trade licence expiry", "type": "date", "iso": "Pty/Id/OrgId/Othr (expiry, SplmtryData)" },
    { "id": "accounts", "title": "Account numbers", "type": "list", "lookup": true, "mask": "account", "iso": "Acct/Id/IBAN or Acct/Id/Othr/Id" },
    { "id": "cif", "title": "CIF", "type": "text", "lookup": true, "mask": "id", "iso": "Pty/Id/OrgId/Othr/Id (SchmeNm/Prtry CIF)" },
    { "id": "unifiedNumber", "title": "Unified number", "type": "text", "mask": "id", "iso": "Pty/Id/OrgId/Othr/Id (SchmeNm/Prtry UNIFIED)" },
    { "id": "active", "title": "Active", "type": "boolean", "required": true },
    { "id": "wpsRegistrationFormHeld", "title": "WPS registration form held", "type": "boolean" },
    { "id": "labourMinistryRegistered", "title": "Registered with the labour ministry", "type": "boolean" },
    { "id": "establishmentId", "title": "Labour ministry establishment id", "type": "text", "lookup": true, "mask": "id", "iso": "Pty/Id/OrgId/Othr/Id (SchmeNm/Prtry MOL)" },
    { "id": "freeZone", "title": "Free zone", "type": "code", "references": "free-zones" },
    { "id": "branch", "title": "Branch", "type": "code", "references": "branches" },
    { "id": "relationshipManager", "title": "Relationship manager", "type": "text", "personal": true, "mask": "name" },
    { "id": "relationshipManagerEmail", "title": "Relationship manager's e-mail", "type": "text", "personal": true, "mask": "name" },
    { "id": "branchManager", "title": "Branch manager", "type": "text", "personal": true, "mask": "name" },
    { "id": "branchManagerEmail", "title": "Branch manager's e-mail", "type": "text", "personal": true, "mask": "name" },
    { "id": "corporateType", "title": "Corporate type", "type": "code" },
    { "id": "contactPerson", "title": "Contact person", "type": "text", "personal": true, "mask": "name", "iso": "Pty/CtctDtls/Nm" }
  ]
}
