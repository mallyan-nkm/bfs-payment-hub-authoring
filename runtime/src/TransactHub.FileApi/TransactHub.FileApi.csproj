    <ProjectReference Include="..\TransactHub.Ports\TransactHub.Ports.csproj" />
    <ProjectReference Include="..\TransactHub.Activities.Platform\TransactHub.Activities.Platform.csproj" />
    <ProjectReference Include="..\TransactHub.Telemetry\TransactHub.Telemetry.csproj" />
    <ProjectReference Include="..\TransactHub.Security\TransactHub.Security.csproj" />
    <ProjectReference Include="..\TransactHub.Auth\TransactHub.Auth.csproj" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

</Project>
