<Project Sdk="Microsoft.NET.Sdk">

  <!-- The service console's logic (spec R-06-25, R-09-39 to R-09-44): health, content, backups, logs, the error dictionary,
       troubleshooting actions and the assistant. Its host is TransactHub.Service.Api; its web app is a section of runtime/ops-console. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The official Anthropic SDK for C#, pinned exactly. -->
    <PackageReference Include="Anthropic" Version="13.7.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TransactHub.Api\TransactHub.Api.csproj" />
    <ProjectReference Include="..\TransactHub.Auth\TransactHub.Auth.csproj" />
    <ProjectReference Include="..\TransactHub.Operations\TransactHub.Operations.csproj" />
    <ProjectReference Include="..\TransactHub.Engine.Flowable\TransactHub.Engine.Flowable.csproj" />
    <ProjectReference Include="..\TransactHub.Telemetry\TransactHub.Telemetry.csproj" />
    <ProjectReference Include="..\TransactHub.Ports\TransactHub.Ports.csproj" />
  </ItemGroup>

</Project>
