<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.17.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TransactHub.Store\TransactHub.Store.csproj" />
    <ProjectReference Include="..\..\src\TransactHub.Store.Migrations.SqlServer\TransactHub.Store.Migrations.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\TransactHub.Store.Migrations.PostgreSql\TransactHub.Store.Migrations.PostgreSql.csproj" />
    <ProjectReference Include="..\..\src\TransactHub.Api\TransactHub.Api.csproj" />
    <ProjectReference Include="..\..\src\TransactHub.Auth\TransactHub.Auth.csproj" />
    <ProjectReference Include="..\..\src\TransactHub.Engine.Temporal\TransactHub.Engine.Temporal.csproj" />
    <ProjectReference Include="..\..\src\TransactHub.Activities.Wps\TransactHub.Activities.Wps.csproj" />
    <ProjectReference Include="..\..\src\TransactHub.Engines.Durable\TransactHub.Engines.Durable.csproj" />
    <ProjectReference Include="..\..\src\TransactHub.Ports\TransactHub.Ports.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The golden corpus, evaluated against the runtime's port (see tools/WpsGolden). -->
    <Compile Include="../../tools/WpsGolden/Corpus.cs" Link="Golden/Corpus.cs" />
    <None Include="Golden/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>