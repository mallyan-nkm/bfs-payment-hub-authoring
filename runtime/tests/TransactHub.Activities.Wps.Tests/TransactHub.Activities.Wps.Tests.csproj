<Project Sdk="Microsoft.NET.Sdk">

  <!-- The WPS inward file formats on the runtime (plan P2): the source's own unit tests (Source/) run against the port, and
       the native activities that use it are tested on the canonical context (NativeInwardTests). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591;xUnit1026;xUnit2013</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="7.2.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TransactHub.Activities.Wps\TransactHub.Activities.Wps.csproj" />
    <ProjectReference Include="..\..\src\TransactHub.Activities.Platform\TransactHub.Activities.Platform.csproj" />
  </ItemGroup>
</Project>
