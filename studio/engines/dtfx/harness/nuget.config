<?xml version="1.0" encoding="utf-8"?>
<!-- The DTFx harness's packages come from nuget.org. Named here so that a machine whose NuGet has
     no source configured (error NU1100) still builds. Any sources the machine already has stay. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
