{
  "name": "transacthub-designer-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TransactHub Designer Studio: define, test and export payment workflows",
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "start": "tsx src/server/main.ts",
    "studio:dev": "tsx src/content/dev.ts",
    "test": "vitest run",
    "test:blackbox": "vitest run --config vitest.blackbox.config.ts",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "studio": "tsx src/cli.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "5.4.21",
    "vitest": "^3.2.7"
  }
}
