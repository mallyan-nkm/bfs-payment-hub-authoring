{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:th:schema:pack",
  "title": "Pack manifest",
  "description": "The lock file of a pack: every artefact, its exact release and its hash. See design/11.",
  "type": "object",
  "required": ["kind", "scope", "release", "packType", "artefacts"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "pack" },
    "scope": { "$ref": "urn:th:schema:common#/$defs/scope" },
    "release": { "$ref": "urn:th:schema:common#/$defs/release" },
    "title": { "type": "string" },
    "packType": { "enum": ["shared", "bank", "test"] },
    "origin": { "enum": ["factory", "authored"] },
    "tenant": { "description": "Bank packs only. The tenant id lives here, never in an artefact name.", "type": "string" },
    "dependsOn": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scope", "release"],
        "additionalProperties": false,
        "properties": {
          "scope": { "$ref": "urn:th:schema:common#/$defs/scope" },
          "release": { "$ref": "urn:th:schema:common#/$defs/release" }
        }
      }
    },
    "artefacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "release", "path"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "kind": { "enum": ["activity", "rule", "ruleset", "table", "simulator", "workflow", "scheme", "hook", "port", "extension", "test", "operations-view", "error-dictionary"] },
          "release": { "$ref": "urn:th:schema:common#/$defs/release" },
          "hash": { "$ref": "urn:th:schema:common#/$defs/hash" },
          "path": { "type": "string" }
        }
      }
    },
    "containsSimulators": { "description": "True for test packs. A pack that contains a simulator is never promoted to production.", "type": "boolean" },
    "promotable": { "type": "boolean" }
  },
  "allOf": [
    { "if": { "properties": { "packType": { "const": "bank" } } }, "then": { "required": ["tenant"], "properties": { "scope": { "const": "b" } } } },
    { "if": { "properties": { "containsSimulators": { "const": true } }, "required": ["containsSimulators"] }, "then": { "properties": { "promotable": { "const": false } }, "required": ["promotable"] } }
  ]
}
