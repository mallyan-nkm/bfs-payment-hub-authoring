{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:th:schema:extension",
  "title": "Context extension registry entry",
  "description": "Scheme or bank fields with no ISO 20022 home. No untyped fields. See design/02.",
  "type": "object",
  "required": ["kind", "name", "release", "title", "root", "fields"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "extension" },
    "name": { "$ref": "urn:th:schema:common#/$defs/artefactName" },
    "release": { "$ref": "urn:th:schema:common#/$defs/release" },
    "title": { "type": "string" },
    "root": { "type": "string", "pattern": "^ext\\.[a-z0-9]+(\\.[a-z0-9]+)*$" },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "isoType", "level", "description"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
          "isoType": { "type": "string", "description": "An ISO 20022 data type, for example Max35Text, ISODate, ActiveCurrencyAndAmount." },
          "level": { "enum": ["payment", "batch", "item"] },
          "description": { "type": "string" },
          "source": { "type": "string" },
          "personalData": { "type": "boolean" }
        }
      }
    },
    "provenance": { "$ref": "urn:th:schema:common#/$defs/provenance" }
  }
}
