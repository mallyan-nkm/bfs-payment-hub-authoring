{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:th:schema:operations-view",
  "title": "Operations view",
  "description": "How operators see a pack's payments and legs in the runtime's operations console: fields and their sources in the store, labels, groups, list columns and filters, a bulk's lines, documents and the operator actions that apply. Data only; the console renders any view the same way. See design/05 section 5.10 (R-05-48 to R-05-50).",
  "type": "object",
  "required": ["kind", "name", "release", "title"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "operations-view" },
    "name": { "$ref": "urn:th:schema:common#/$defs/artefactName" },
    "release": { "$ref": "urn:th:schema:common#/$defs/release" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "scheme": { "description": "The scheme whose payments and legs this view shows. Absent for the platform's view (scope p), which applies to every payment.", "$ref": "urn:th:schema:common#/$defs/scope" },
    "platform": { "description": "The platform view only: the platform workflows it shows.", "type": "array", "items": { "$ref": "urn:th:schema:common#/$defs/artefactName" } },
    "subject": { "$ref": "#/$defs/section" },
    "legs": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/section" },
          {
            "type": "object",
            "required": ["leg", "selectBy"],
            "properties": {
              "leg": { "$ref": "urn:th:schema:common#/$defs/artefactName" },
              "selectBy": {
                "description": "How the projection tells this leg's engine instance from another: the header's direction and kind, and steps only this leg has.",
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "direction": { "enum": ["inward", "outward"] },
                  "kind": { "enum": ["payment", "request", "return", "refund"] },
                  "steps": { "type": "array", "minItems": 1, "items": { "type": "string" } }
                }
              }
            }
          }
        ]
      }
    },
    "parameters": { "description": "The operations console's dials that read this view (R-05-66 to R-05-70): each a parameter with a type, a default and bounds, as every artefact's (R-04-08). A bank sets them in its configuration release as `<view>#<parameter>`; the console reads the value in force by date. The platform's view declares tatLimit, unmaskWindow and retentionPeriod; a scheme's view MAY declare tatLimit and retentionPeriod for its own payments, which then win.", "$ref": "urn:th:schema:common#/$defs/parameters" },
    "provenance": { "$ref": "urn:th:schema:common#/$defs/provenance" }
  },
  "$defs": {
    "report": {
      "description": "A fixed report (R-05-67, Issue I-144): a CSV of declared fields, one row per payment (rows subject), per line (lines) or per kept document of a kind the view declares (documents). A column names a field of the subject (<id>), a line field (line.<id>) or a document's attribute (document.fileName, at, size, source, direction, signed).",
      "type": "object",
      "required": ["id", "title", "rows", "columns"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "rows": { "enum": ["subject", "lines", "documents"] },
        "document": { "description": "For rows documents: the document kind the report lists, one the view declares.", "type": "string" },
        "columns": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^((line|document)\\.)?[a-z][A-Za-z0-9]*$" } },
        "oldScreen": { "type": "string" }
      }
    },
    "fieldId": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
    "field": {
      "type": "object",
      "required": ["id", "label", "source"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/fieldId" },
        "label": { "type": "string" },
        "group": { "type": "string" },
        "source": { "type": "string", "minLength": 3, "description": "Where the value comes from in the store. See design/05 section 5.10." },
        "format": { "enum": ["text", "amount", "count", "date", "datetime", "status", "code", "json"] },
        "mask": { "enum": ["account", "id", "name", "full", "none"], "description": "How a value that is personal data is masked in the read model (R-05-49). none shows it whole, as the old screen named in oldScreen did." },
        "description": { "type": "string" },
        "oldScreen": { "type": "string", "description": "Where the source system's screen showed it, for the mapping (Issue I-100)." }
      }
    },
    "group": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": { "id": { "type": "string" }, "title": { "type": "string" } }
    },
    "filter": {
      "type": "object",
      "required": ["field"],
      "additionalProperties": false,
      "properties": {
        "field": { "$ref": "#/$defs/fieldId" },
        "match": { "enum": ["exact", "contains", "range"] },
        "label": { "type": "string" }
      }
    },
    "action": {
      "type": "object",
      "required": ["action", "role"],
      "additionalProperties": false,
      "properties": {
        "action": { "enum": ["approve", "decline", "release", "reject", "cancel", "re-screen", "pause", "resume", "retry", "resend"] },
        "label": { "type": "string" },
        "role": { "enum": ["Operator", "Supervisor"] },
        "secondApprover": { "enum": ["Operator", "Supervisor"], "description": "Maker-checker: carried out only when another person with this role approves." },
        "remarks": { "enum": ["required", "optional"] },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hold": { "enum": ["approval", "repair"] },
            "workflow": { "type": "array", "minItems": 1, "items": { "$ref": "urn:th:schema:common#/$defs/artefactName" }, "description": "The platform workflows the action applies to (R-05-61); without it, every platform workflow of the view." },
            "status": { "type": "array", "items": { "type": "string" } },
            "notStatus": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "section": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "groups": { "type": "array", "items": { "$ref": "#/$defs/group" } },
        "columns": { "type": "array", "items": { "$ref": "#/$defs/fieldId" } },
        "filters": { "type": "array", "items": { "$ref": "#/$defs/filter" } },
        "lines": {
          "type": "object",
          "required": ["fields"],
          "additionalProperties": false,
          "properties": {
            "title": { "type": "string" },
            "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
            "columns": { "type": "array", "items": { "$ref": "#/$defs/fieldId" } }
          }
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "label"],
            "additionalProperties": false,
            "properties": { "kind": { "type": "string" }, "label": { "type": "string" } }
          }
        },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "reports": { "type": "array", "items": { "$ref": "#/$defs/report" } },
        "leg": true,
        "selectBy": true
      },
      "additionalProperties": false
    }
  }
}
