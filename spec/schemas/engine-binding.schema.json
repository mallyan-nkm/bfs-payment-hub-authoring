{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:th:schema:engine-binding",
  "title": "Engine binding",
  "description": "Engine settings kept apart from the DSL. The designer never edits this file. See design/09.",
  "type": "object",
  "required": ["kind", "target", "strategy", "queues", "taskNaming"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "engine-binding" },
    "target": { "enum": ["temporal", "dtfx", "flowable"] },
    "strategy": { "enum": ["interpreter", "generation"] },
    "queues": {
      "description": "Worker queue or topic per scope.",
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "taskNaming": {
      "description": "How a task is registered. The exact release is part of the identity.",
      "const": "<name>@<release>"
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "queueTimeout": { "$ref": "urn:th:schema:common#/$defs/duration" },
        "heartbeat": { "$ref": "urn:th:schema:common#/$defs/duration" },
        "forEachChunk": { "type": "integer", "minimum": 1 },
        "historyLimit": { "type": "integer", "minimum": 1 }
      }
    },
    "extensions": {
      "description": "Target-specific settings outside the portable core.",
      "type": "object"
    }
  }
}
