{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:th:schema:workflow",
  "title": "Workflow DSL",
  "description": "Platform workflow, scheme leg, segment or handler. Block-structured, engine-neutral. See design/05.",
  "type": "object",
  "required": [
    "kind",
    "wfKind",
    "name",
    "release",
    "dsl",
    "title",
    "do"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "workflow"
    },
    "wfKind": {
      "enum": [
        "platform",
        "leg",
        "segment",
        "handler",
        "subflow"
      ]
    },
    "name": {
      "$ref": "urn:th:schema:common#/$defs/artefactName"
    },
    "release": {
      "$ref": "urn:th:schema:common#/$defs/release"
    },
    "dsl": {
      "$ref": "urn:th:schema:common#/$defs/release"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "direction": {
      "enum": [
        "inward",
        "outward"
      ]
    },
    "implements": {
      "description": "A leg names the slot it fills. A subflow names the activity it implements.",
      "oneOf": [
        {
          "description": "Legs: the slot this leg fills.",
          "type": "object",
          "required": [
            "slot",
            "of"
          ],
          "additionalProperties": false,
          "properties": {
            "slot": {
              "$ref": "urn:th:schema:common#/$defs/identifier"
            },
            "of": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "urn:th:schema:common#/$defs/artefactName"
              }
            }
          }
        },
        {
          "description": "Subflows: the composite activity this subflow implements.",
          "type": "object",
          "required": [
            "activity"
          ],
          "additionalProperties": false,
          "properties": {
            "activity": {
              "$ref": "urn:th:schema:common#/$defs/artefactName"
            }
          }
        }
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reads": {
          "type": "array",
          "items": {
            "$ref": "urn:th:schema:common#/$defs/contextPath"
          }
        }
      }
    },
    "exit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "writes": {
          "type": "array",
          "items": {
            "$ref": "urn:th:schema:common#/$defs/contextPath"
          }
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:th:schema:common#/$defs/identifier"
          }
        }
      }
    },
    "slots": {
      "description": "Platform workflows only. A slot is a contract that any conforming leg fills.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "contract"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "$ref": "urn:th:schema:common#/$defs/identifier"
          },
          "contract": {
            "type": "object",
            "required": [
              "reads",
              "writes",
              "outcomes"
            ],
            "additionalProperties": false,
            "properties": {
              "reads": {
                "type": "array",
                "items": {
                  "$ref": "urn:th:schema:common#/$defs/contextPath"
                }
              },
              "writes": {
                "type": "array",
                "items": {
                  "$ref": "urn:th:schema:common#/$defs/contextPath"
                }
              },
              "outcomes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "urn:th:schema:common#/$defs/identifier"
                }
              },
              "primaryOutcome": {
                "$ref": "urn:th:schema:common#/$defs/identifier"
              }
            }
          }
        }
      }
    },
    "hookPoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type",
          "contract",
          "policy"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "$ref": "urn:th:schema:common#/$defs/identifier"
          },
          "type": {
            "enum": [
              "halt",
              "transform",
              "notify"
            ]
          },
          "description": {
            "type": "string"
          },
          "contract": {
            "type": "object",
            "required": [
              "reads"
            ],
            "additionalProperties": false,
            "properties": {
              "reads": {
                "type": "array",
                "items": {
                  "$ref": "urn:th:schema:common#/$defs/contextPath"
                }
              },
              "writes": {
                "type": "array",
                "items": {
                  "$ref": "urn:th:schema:common#/$defs/contextPath"
                }
              }
            }
          },
          "policy": {
            "type": "object",
            "required": [
              "timeout",
              "onFailure"
            ],
            "additionalProperties": false,
            "properties": {
              "timeout": {
                "$ref": "urn:th:schema:common#/$defs/duration"
              },
              "onFailure": {
                "enum": [
                  "fail-open",
                  "fail-closed"
                ]
              },
              "onHold": {
                "$ref": "urn:th:schema:common#/$defs/artefactName"
              }
            }
          }
        }
      }
    },
    "signals": {
      "description": "The fixed emergency signal set. Designers cannot add signals.",
      "type": "array",
      "items": {
        "enum": [
          "pause",
          "resume",
          "cancel",
          "re-screen"
        ]
      },
      "uniqueItems": true
    },
    "parameters": {
      "$ref": "urn:th:schema:common#/$defs/parameters"
    },
    "deadline": {
      "type": "object",
      "required": [
        "after",
        "do"
      ],
      "additionalProperties": false,
      "properties": {
        "after": {
          "$ref": "urn:th:schema:common#/$defs/duration"
        },
        "do": {
          "$ref": "#/$defs/steps"
        }
      }
    },
    "synchronous": {
      "description": "Marks a workflow whose steps may run on a fast path. See open decision D9.",
      "type": "boolean"
    },
    "artefacts": {
      "$ref": "urn:th:schema:common#/$defs/pins"
    },
    "do": {
      "$ref": "#/$defs/steps"
    },
    "provenance": {
      "$ref": "urn:th:schema:common#/$defs/provenance"
    },
    "finally": {
      "description": "Steps that run on every end, whatever the outcome, after any compensation.",
      "$ref": "#/$defs/steps"
    },
    "form": {
      "description": "authored is what a designer writes and the studio stores. expanded is derived from it by expansion and is what an engine runs. Default authored.",
      "enum": [
        "authored",
        "expanded"
      ]
    },
    "expandedFrom": {
      "description": "Expanded form only: the authored release this was derived from.",
      "type": "object",
      "required": [
        "release",
        "hash"
      ],
      "additionalProperties": false,
      "properties": {
        "release": {
          "$ref": "urn:th:schema:common#/$defs/release"
        },
        "hash": {
          "$ref": "urn:th:schema:common#/$defs/hash"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "wfKind": {
            "const": "leg"
          }
        }
      },
      "then": {
        "required": [
          "implements",
          "direction",
          "exit"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "wfKind": {
            "const": "platform"
          }
        }
      },
      "then": {
        "required": [
          "slots",
          "exit"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "wfKind": {
            "const": "subflow"
          }
        }
      },
      "then": {
        "required": [
          "implements",
          "exit"
        ]
      }
    }
  ],
  "$defs": {
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "step": {
      "oneOf": [
        {
          "$ref": "#/$defs/callStep"
        },
        {
          "$ref": "#/$defs/switchStep"
        },
        {
          "$ref": "#/$defs/parallelStep"
        },
        {
          "$ref": "#/$defs/forEachStep"
        },
        {
          "$ref": "#/$defs/loopStep"
        },
        {
          "$ref": "#/$defs/awaitStep"
        },
        {
          "$ref": "#/$defs/waitStep"
        },
        {
          "$ref": "#/$defs/slotStep"
        },
        {
          "$ref": "#/$defs/useStep"
        },
        {
          "$ref": "#/$defs/tryStep"
        },
        {
          "$ref": "#/$defs/hookStep"
        },
        {
          "$ref": "#/$defs/endStep"
        },
        {
          "$ref": "#/$defs/returnStep"
        },
        {
          "$ref": "#/$defs/blockStep"
        }
      ]
    },
    "outcomeAction": {
      "description": "What to do on a non-primary outcome: run steps, end the workflow, carry on, or (in a subflow) return an outcome.",
      "oneOf": [
        {
          "$ref": "#/$defs/steps"
        },
        {
          "type": "object",
          "required": [
            "end"
          ],
          "additionalProperties": false,
          "properties": {
            "end": {
              "$ref": "urn:th:schema:common#/$defs/identifier"
            },
            "compensate": {
              "const": "all"
            }
          }
        },
        {
          "description": "Record the outcome and carry on. A later decide block reads it.",
          "type": "object",
          "required": [
            "continue"
          ],
          "additionalProperties": false,
          "properties": {
            "continue": {
              "const": true
            }
          }
        },
        {
          "description": "Subflows and blocks only: give this outcome back to the step that called the composite activity.",
          "type": "object",
          "required": [
            "return"
          ],
          "additionalProperties": false,
          "properties": {
            "return": {
              "$ref": "urn:th:schema:common#/$defs/identifier"
            }
          }
        }
      ]
    },
    "onMap": {
      "type": "object",
      "propertyNames": {
        "$ref": "urn:th:schema:common#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/outcomeAction"
      },
      "description": "Outcome name to action. The key is handle, never on: YAML 1.1 reads on as a boolean."
    },
    "callStep": {
      "type": "object",
      "required": [
        "call"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/stepId"
        },
        "call": {
          "$ref": "urn:th:schema:common#/$defs/artefactName"
        },
        "level": {
          "enum": [
            "payment",
            "batch",
            "item"
          ]
        },
        "policy": {
          "$ref": "urn:th:schema:common#/$defs/policy"
        },
        "handle": {
          "$ref": "#/$defs/onMap"
        }
      }
    },
    "switchStep": {
      "description": "Branch on a named outcome or decision. Never on payment data.",
      "type": "object",
      "required": [
        "switch"
      ],
      "additionalProperties": false,
      "properties": {
        "switch": {
          "type": "object",
          "required": [
            "by",
            "cases"
          ],
          "additionalProperties": false,
          "properties": {
            "cases": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "$ref": "#/$defs/steps"
              }
            },
            "default": {
              "$ref": "#/$defs/steps"
            },
            "by": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 1,
              "additionalProperties": false,
              "properties": {
                "outcomeOf": {
                  "$ref": "#/$defs/stepId"
                },
                "decision": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "parallelStep": {
      "type": "object",
      "required": [
        "parallel"
      ],
      "additionalProperties": false,
      "properties": {
        "parallel": {
          "type": "object",
          "required": [
            "branches"
          ],
          "additionalProperties": false,
          "properties": {
            "branches": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/steps"
              }
            },
            "join": {
              "const": "all"
            }
          }
        }
      }
    },
    "forEachStep": {
      "type": "object",
      "required": [
        "forEach"
      ],
      "additionalProperties": false,
      "properties": {
        "forEach": {
          "type": "object",
          "required": [
            "in",
            "do"
          ],
          "additionalProperties": false,
          "properties": {
            "in": {
              "$ref": "urn:th:schema:common#/$defs/contextPath"
            },
            "do": {
              "$ref": "#/$defs/steps"
            },
            "concurrency": {
              "type": "integer",
              "minimum": 1
            },
            "onItemFailure": {
              "enum": [
                "continue",
                "stop"
              ]
            }
          }
        }
      }
    },
    "loopStep": {
      "description": "A bounded loop. Used for business retry such as a status inquiry.",
      "type": "object",
      "required": [
        "loop"
      ],
      "additionalProperties": false,
      "properties": {
        "loop": {
          "type": "object",
          "required": [
            "max",
            "do"
          ],
          "additionalProperties": false,
          "properties": {
            "max": {
              "type": "integer",
              "minimum": 1
            },
            "every": {
              "$ref": "urn:th:schema:common#/$defs/duration"
            },
            "until": {
              "type": "object",
              "required": [
                "outcomeOf",
                "in"
              ],
              "additionalProperties": false,
              "properties": {
                "outcomeOf": {
                  "$ref": "#/$defs/stepId"
                },
                "in": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "urn:th:schema:common#/$defs/identifier"
                  }
                }
              }
            },
            "do": {
              "$ref": "#/$defs/steps"
            }
          }
        }
      }
    },
    "awaitStep": {
      "type": "object",
      "required": [
        "await"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/stepId"
        },
        "await": {
          "type": "object",
          "required": [
            "message",
            "correlateBy",
            "onTimeout"
          ],
          "additionalProperties": false,
          "properties": {
            "message": {
              "type": "string",
              "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
            },
            "correlateBy": {
              "$ref": "urn:th:schema:common#/$defs/contextPath"
            },
            "family": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "description": "Take only a message of this family: the family the front door reads from the message, for example the file an acknowledgement answers (R-05-44). It MUST be one of the families the message's dispatch entry declares."
            },
            "timeout": {
              "$ref": "#/$defs/durationOrParameter",
              "description": "May be left out only in a subflow: the await then waits for the replyTimeout of the step that called the composite."
            },
            "calendar": {
              "enum": [
                "elapsed",
                "business"
              ]
            },
            "onTimeout": {
              "$ref": "#/$defs/outcomeAction"
            }
          }
        }
      }
    },
    "waitStep": {
      "type": "object",
      "required": [
        "wait"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/stepId"
        },
        "wait": {
          "$ref": "#/$defs/durationOrParameter",
          "description": "A duration, or, in a subflow only, a parameter of its composite activity."
        }
      }
    },
    "slotStep": {
      "type": "object",
      "required": [
        "slot"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/stepId"
        },
        "slot": {
          "$ref": "urn:th:schema:common#/$defs/identifier"
        },
        "handle": {
          "$ref": "#/$defs/onMap"
        }
      }
    },
    "useStep": {
      "description": "Inline a segment.",
      "type": "object",
      "required": [
        "use"
      ],
      "additionalProperties": false,
      "properties": {
        "use": {
          "$ref": "urn:th:schema:common#/$defs/artefactName"
        }
      }
    },
    "tryStep": {
      "type": "object",
      "required": [
        "try"
      ],
      "additionalProperties": false,
      "properties": {
        "try": {
          "$ref": "#/$defs/steps"
        },
        "catch": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "error",
              "do"
            ],
            "additionalProperties": false,
            "properties": {
              "error": {
                "type": "string"
              },
              "do": {
                "$ref": "#/$defs/outcomeAction"
              }
            }
          }
        },
        "compensate": {
          "const": "all"
        }
      }
    },
    "hookStep": {
      "type": "object",
      "required": [
        "hook"
      ],
      "additionalProperties": false,
      "properties": {
        "hook": {
          "$ref": "urn:th:schema:common#/$defs/identifier"
        }
      }
    },
    "endStep": {
      "type": "object",
      "required": [
        "end"
      ],
      "additionalProperties": false,
      "properties": {
        "end": {
          "$ref": "urn:th:schema:common#/$defs/identifier"
        },
        "compensate": {
          "const": "all"
        }
      }
    },
    "stepId": {
      "description": "A step id. In the expanded form the steps inside a block carry the id of the step that called it as a prefix, joined by a dot.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(\\.[a-z][a-z0-9]*(-[a-z0-9]+)*)*$"
    },
    "returnStep": {
      "description": "Subflows and blocks only: give this outcome back to the step that called the composite activity.",
      "type": "object",
      "required": [
        "return"
      ],
      "additionalProperties": false,
      "properties": {
        "return": {
          "$ref": "urn:th:schema:common#/$defs/identifier"
        }
      }
    },
    "blockStep": {
      "description": "Expanded form only. One composite step with the steps of its subflow inside it. A return inside gives the block its outcome; handle then applies as on a call.",
      "type": "object",
      "required": [
        "id",
        "block"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/stepId"
        },
        "block": {
          "type": "object",
          "required": [
            "of",
            "by",
            "do"
          ],
          "additionalProperties": false,
          "properties": {
            "of": {
              "description": "The composite activity.",
              "$ref": "urn:th:schema:common#/$defs/artefactName"
            },
            "by": {
              "description": "The subflow that was expanded.",
              "$ref": "urn:th:schema:common#/$defs/artefactName"
            },
            "do": {
              "$ref": "#/$defs/steps"
            }
          }
        },
        "handle": {
          "$ref": "#/$defs/onMap"
        }
      }
    },
    "durationOrParameter": {
      "description": "A duration, or a parameter of the composite activity whose subflow holds the step (R-05-45). In the authored subflow the parameter is its bare name; the expanded form names it as <activity>#<name> and carries its default. Its value is looked up on the business date the step starts.",
      "oneOf": [
        {
          "$ref": "urn:th:schema:common#/$defs/duration"
        },
        {
          "type": "object",
          "required": [
            "parameter"
          ],
          "additionalProperties": false,
          "properties": {
            "parameter": {
              "type": "string",
              "pattern": "^([a-z0-9]+(\\.[a-z0-9-]+)+#)?[A-Za-z][A-Za-z0-9]*$"
            },
            "default": {
              "$ref": "urn:th:schema:common#/$defs/duration"
            }
          }
        }
      ]
    }
  }
}
