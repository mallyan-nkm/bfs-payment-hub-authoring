{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:th:schema:supersession",
  "title": "Supersession",
  "description": "An approved replacement of one pinned release by a later one of the same major line. The only way a fix reaches a payment in flight. See design/01.",
  "type": "object",
  "required": ["kind", "id", "artefact", "replaces", "with", "scope", "evidence", "approval"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "supersession" },
    "id": { "type": "string", "pattern": "^SUP-[0-9]{4}-[0-9]{3,}$" },
    "artefact": { "$ref": "urn:th:schema:common#/$defs/artefactName" },
    "replaces": { "$ref": "urn:th:schema:common#/$defs/release" },
    "with": { "$ref": "urn:th:schema:common#/$defs/release" },
    "reason": { "type": "string" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workflowReleases": { "type": "array", "items": { "type": "string" } },
        "schemes": { "type": "array", "items": { "$ref": "urn:th:schema:common#/$defs/scope" } },
        "tenants": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidence": {
      "description": "The pinned workflow releases' test packs, rerun with the replacement swapped in.",
      "type": "object",
      "required": ["testRuns"],
      "additionalProperties": false,
      "properties": {
        "testRuns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["workflow", "release", "result"],
            "additionalProperties": false,
            "properties": {
              "workflow": { "$ref": "urn:th:schema:common#/$defs/artefactName" },
              "release": { "$ref": "urn:th:schema:common#/$defs/release" },
              "result": { "const": "green" }
            }
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "required": ["maker", "checker"],
      "additionalProperties": false,
      "properties": {
        "maker": { "type": "string" },
        "checker": { "type": "string" },
        "secondApprover": { "type": "string", "description": "Set by Service operations when the supersession is applied." }
      }
    }
  }
}
